{
  "version": 2,
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/mandatory-public-disclosure",
      "destination": "/mandatory-public-disclosure.html"
    },
    {
      "source": "/faculty-staff",
      "destination": "/faculty-staff.html"
    },
    {
      "source": "/about-school",
      "destination": "/about-school.html"
    },
    {
      "source": "/academics",
      "destination": "/academics.html"
    },
    {
      "source": "/admissions",
      "destination": "/admissions.html"
    },
    {
      "source": "/infrastructure",
      "destination": "/infrastructure.html"
    },
    {
      "source": "/fee-structure",
      "destination": "/fee-structure.html"
    },
    {
      "source": "/academic-calendar",
      "destination": "/academic-calendar.html"
    },
    {
      "source": "/transfer-certificates",
      "destination": "/transfer-certificates.html"
    },
    {
      "source": "/school-management",
      "destination": "/school-management.html"
    },
    {
      "source": "/notices",
      "destination": "/notices.html"
    },
    {
      "source": "/downloads",
      "destination": "/downloads.html"
    },
    {
      "source": "/results-achievements",
      "destination": "/results-achievements.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
